# Copy to .env.local for development; set the same names on the host.

# Which registry/<cluster>.json the link service reads.
EARNOUT_CLUSTER=devnet

# Read by the link service to check whether a campaign has ended.
RPC_URL=https://api.devnet.solana.com

# The Earnout identity that signs every link's reference, as the JSON array
# solana-keygen writes. Campaigns name its public key as their identity.
EARNOUT_IDENTITY_KEYPAIR=

# At least 32 bytes of hex (openssl rand -hex 32). References are encrypted
# under keys derived from this; changing it orphans every link already
# clicked, so set it once.
EARNOUT_REFERENCE_SECRET=
