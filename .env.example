# Copy to .env.local for development; set the same names on the host.

# Which registry/<cluster>.json the link service and the settler read.
EARNOUT_CLUSTER=devnet

# The RPC every server-side read goes through: the site's pages and its
# /api/rpc relay (so a paid key never reaches a browser), the faucets, the
# settler, and every script. Public devnet if unset.
RPC_URL=https://api.devnet.solana.com

# The Earnout identity that signs every link's reference, as the JSON array
# solana-keygen writes. Campaigns name its public key as their identity.
EARNOUT_IDENTITY_KEYPAIR=

# At least 32 bytes of hex (openssl rand -hex 32). References are encrypted
# under keys derived from this; changing it orphans every link already
# clicked, so set it once.
EARNOUT_REFERENCE_SECRET=

# The earnout Supabase project. The site reads public reports and the
# registry with the publishable key (both default to the project's own
# values, so the host needs neither). The secret key bypasses row security:
# the settler needs it for its private ledger and its report, and the site
# needs it to record campaigns made from the dashboard (only ever from a
# transaction the advertiser signed; see src/server/campaign-registry.ts).
# Give each its own key from the Supabase dashboard, so either can be
# revoked alone.
SUPABASE_URL=https://rglvyzffulvsyawnrenw.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_FnShmwGT2wZnIWnItam2Ng_7Myr77E9
SUPABASE_SECRET_KEY=

# The settler every campaign made from the dashboard names: the public key of
# the key scripts/settle.ts runs with. Defaults to Earnout's devnet settler.
EARNOUT_SETTLER_ADDRESS=

# The settler's own key, for scripts/settle.ts: the key itself as a JSON
# array (how the scheduled runner passes it from a secret), or a path to a
# keyfile. With neither, the deploy wallet at ~/.config/solana/id.json.
SETTLER_KEYPAIR_JSON=
SETTLER_KEYPAIR=

# The demo faucet key, as a JSON array: hands out 0.02 devnet SOL
# (/api/faucet) and mints test dollars (/api/faucet/usd). The site alone
# needs it; without it both faucets say they are off.
FAUCET_KEYPAIR=

# scripts/devnet-smoke.ts signs with this keyfile; the deploy wallet if unset.
KEYPAIR=

# Sign in with X (console.x.com): the OAuth 2.0 client of the Earnout app,
# with https://earnout.dev/api/x/callback as a callback. Influencers link
# their X account to their wallet with it; the site alone needs these.
X_CLIENT_ID=
X_CLIENT_SECRET=
